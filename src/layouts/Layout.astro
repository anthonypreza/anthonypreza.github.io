---
import '../styles/global.css';
const { title = 'Anthony Preza', description = 'Anthony Preza. Senior data engineer at Netflix. Personal machine learning projects.' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}images/portfolio-card.png`, Astro.site ?? Astro.url.origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="Anthony Preza — Machine learning projects" />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body><main><slot /></main></body>
</html>
