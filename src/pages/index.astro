---
import Layout from '../layouts/Layout.astro';
import projects from '../data/projects.json';
import profile from '../data/profile.json';
---
<Layout>
  <header class="profile-intro">
    <img class="portrait" src={`${import.meta.env.BASE_URL}images/anthony-preza.jpeg`} alt="Anthony Preza" width="104" height="104" />
    <h1>{profile.name}</h1>
    <p class="introduction">Hey there, welcome to my site! I'm currently a Senior Data Engineer at Netflix, where I build distributed data products and infrastructure supporting machine learning for commerce. In my free time, I enjoy experimenting with machine learning and building things to see how they work. Most of my side projects explore practical machine learning across computer vision, sequence modeling, and representation learning. I love to build things that are useful or line up with my interests outside of tech, such as music, and you'll see my projects reflect that. Thanks for visiting!</p>
    <p class="music-note">I also make music as {profile.music.artist}. <a href={profile.music.url} target="_blank" rel="noopener noreferrer">Pre-save {profile.music.title}</a>.</p>
  </header>
  <section aria-label="Projects" class="projects">
    {projects.map(project => (
      <article>
        <h2>{project.title}</h2>
        <p>{project.description}</p>
        {project.status && <p class="status">{project.status}</p>}
        <p class="project-link"><a href={`${import.meta.env.BASE_URL}projects/${project.slug}/`} aria-label={`Read the ${project.title} writeup`}>Read writeup</a></p>
      </article>
    ))}
  </section>
  <footer><nav aria-label="Profile links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={profile.music.url} target="_blank" rel="noopener noreferrer">Music</a></nav></footer>
</Layout>
